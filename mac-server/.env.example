# Bearer token shared with paired iPhone. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CACTUS_TOKEN=changeme-generate-with-secrets-module

# Bind address. Default 0.0.0.0 makes the server reachable on local Wi-Fi.
CACTUS_HOST=0.0.0.0
CACTUS_PORT=8731

# mobile-use invocation. Either "uvx" / "uv" / "python -m" / absolute path.
# Defaults to `uv run mobile-use` which assumes you have https://github.com/minitap-ai/mobile-use
# either installed via pipx or available on PATH.
MOBILE_USE_CMD=uv run mobile-use

# Optional: restrict to a specific iOS Simulator UDID (xcrun simctl list devices)
TARGET_UDID=

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
